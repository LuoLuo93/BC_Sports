<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bcsport.admin.erpmapper.BjerpEmployeeMapper">

    <!-- REST v3 ObjectModify 以 id 定位：工号 → HR_EMPLOYEE.ID（报文全字段按 IHR 最新覆盖，不做差异比对） -->
    <select id="selectIdByStaffNo" resultType="java.lang.Long">
        SELECT e.ID
        FROM HR_EMPLOYEE e
        WHERE TRIM(e.NO) = TRIM(#{staffNo})
          AND ROWNUM = 1
    </select>

    <!-- 报文必含店仓名的前置校验：IHR 部门名必须在 ERP 店仓精确存在，否则视为店名漂移 -->
    <select id="countActiveStoreByName" resultType="int">
        SELECT COUNT(*)
        FROM C_STORE
        WHERE NAME = #{storeName}
          AND ISACTIVE = 'Y'
    </select>

</mapper>
